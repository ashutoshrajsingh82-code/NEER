# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.log

# --- Node / Next.js ---
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.env*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Env files ---
.env
.env.*
!.env.example

# --- Data & artifacts (kept out of version control by default) ---
data/raw/*
data/processed/*
data/demo/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/demo/.gitkeep

artifacts/checkpoints/*
artifacts/embeddings/*
artifacts/predictions/*
!artifacts/checkpoints/.gitkeep
!artifacts/embeddings/.gitkeep
!artifacts/predictions/.gitkeep

reports/*
!reports/.gitkeep

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Docker ---
*.pid
